{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "jest": true
  },
  // No `jest` plugin: its rules only match `@jest/globals`/global-style tests,
  // and this project imports from `bun:test`, so none of them can ever fire.
  // `env.jest` stays on to declare the globals `bun test` injects.
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Type-aware rules from typescript-eslint's `recommendedTypeChecked`
    // that oxlint does not enable via the `correctness` category.
    "typescript/require-await": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",

    // Project overrides, carried over from the old eslint.config.mjs.
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "warn",
    "typescript/no-unsafe-argument": "warn",

    // NestJS modules are intentionally empty decorated classes.
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],

    // Spreading nestjs-zod DTO instances into plain payload objects is the
    // intended pattern here; the lost prototype is not used downstream.
    "typescript/no-misused-spread": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "src/modules/db/migrations"]
}
