{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun --watch run ./src/index.ts",
    "db:generate": "bun --bun run drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "bun --bun run drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:push": "bun --bun run drizzle-kit push --config=./src/db/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-rc.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  }
}
