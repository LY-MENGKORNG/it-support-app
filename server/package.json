{
  "name": "it-support-server",
  "version": "0.0.1",
  "description": "",
  "author": "LY-MENGKORNG",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "bun --bun run nest build",
    "fmt": "bun --bun run oxfmt --write \"src/**/*.ts\"",
    "fmt:check": "bun --bun run oxfmt --check \"src/**/*.ts\"",
    "start": "bun --bun run nest start",
    "start:dev": "bun --watch ./src/main.ts",
    "start:debug": "bun --bun run nest start --debug --watch",
    "start:prod": "bun dist/main",
    "lint": "bun --bun run oxlint --type-aware src --fix",
    "lint:check": "bun --bun run oxlint --type-aware src",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:cov": "bun test src --coverage",
    "test:debug": "bun test src --inspect-brk",
    "db:generate": "bun --bun run prisma generate --config=./src/config/prisma.config.ts",
    "db:migrate": "bun --bun run prisma migrate dev --config=./src/config/prisma.config.ts",
    "db:push": "bun --bun run prisma db push --config=./src/config/prisma.config.ts",
    "db:studio": "bun --bun run prisma studio --config=./src/config/prisma.config.ts",
    "db:seed": "bun ./src/config/db/seed.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "dotenv": "^18.0.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "runtime": {
      "name": "bun"
    },
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
