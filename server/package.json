{
  "name": "it-support-server",
  "version": "0.0.1",
  "description": "",
  "author": "LY-MENGKORNG",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "bun --bun run nest build",
    "fmt": "bun --bun run oxfmt --write \"src/**/*.ts\"",
    "fmt:check": "bun --bun run oxfmt --check \"src/**/*.ts\"",
    "start": "bun --bun run nest start",
    "start:dev": "bun --watch ./src/main.ts",
    "start:debug": "bun --bun run nest start --debug --watch",
    "start:prod": "bun dist/main",
    "lint": "bun --bun run oxlint --type-aware src --fix",
    "lint:check": "bun --bun run oxlint --type-aware src",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:cov": "bun test src --coverage",
    "test:debug": "bun test src --inspect-brk",
    "db:generate": "bun --bun run drizzle-kit generate --config=./src/config/drizzle.config.ts",
    "db:migrate": "bun --bun run drizzle-kit migrate --config=./src/config/drizzle.config.ts",
    "db:push": "bun --bun run drizzle-kit push --config=./src/config/drizzle.config.ts",
    "db:studio": "bun --bun run drizzle-kit studio --config=./src/config/drizzle.config.ts",
    "db:seed": "bun ./src/config/db/seed.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "drizzle-orm": "^1.0.0-rc.4",
    "drizzle-seed": "^1.0.0-rc.4",
    "drizzle-zod": "^0.8.3",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
