model Comment {
  id        Int       @id @default(autoincrement())
  requestId Int
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  @@index([requestId])
  @@index([userId])
}
