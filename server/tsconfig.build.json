{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep the incremental cache inside outDir so nest's `deleteOutDir` (and a
    // manual `rm -rf dist`) invalidate it; otherwise tsc silently emits nothing.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
